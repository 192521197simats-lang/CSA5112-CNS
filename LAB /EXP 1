CEASER CIPHER 
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char text[100];
    int key, i;
    char ch;

    printf("Enter a message: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter the key: ");
    scanf("%d", &key);

    key = ((key % 26) + 26) % 26;

    // Encryption
    for (i = 0; text[i] != '\0'; i++) {
        ch = text[i];

        if (isupper(ch))
            text[i] = (ch - 'A' + key) % 26 + 'A';
        else if (islower(ch))
            text[i] = (ch - 'a' + key) % 26 + 'a';
    }

    printf("Encrypted message: %s", text);

    // Decryption
    for (i = 0; text[i] != '\0'; i++) {
        ch = text[i];

        if (isupper(ch))
            text[i] = (ch - 'A' - key + 26) % 26 + 'A';
        else if (islower(ch))
            text[i] = (ch - 'a' - key + 26) % 26 + 'a';
    }

    printf("Decrypted message: %s", text);

    return 0;
}
